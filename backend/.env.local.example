# 数据库连接示例：复制为 .env.local 后填入真实值
# .env.local 已被 .gitignore 排除，不会提交
#
# 用法：cp .env.local.example .env.local 然后编辑，再执行 ./run.sh

export MYSQL_HOST=127.0.0.1
export MYSQL_PORT=3306
export MYSQL_DB=mf_backend
export MYSQL_USER=root
export MYSQL_PASSWORD=在这里填你的数据库密码

# 可选：数据库在内网、需要跳板时填 SSH 目标
# run.sh 检测到本地端口不通会自动建立隧道，脚本退出时关闭
# export MYSQL_TUNNEL=root@你的服务器IP
